{
  "compilerOptions": {
    "target": "es2022",
    "module": "ESNext",
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "noImplicitAny": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "experimentalDecorators": true
  },
   "include": [
    "src/**/*"
  ],

  "exclude": [
    "node_modules"
  ]
}